OPENAI_API_KEY=your_openai_api_key
TAVILY_API_KEY=your_tavily_api_key
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key
LANGCHAIN_PROJECT=imdb-rag-chatbot

# KOBIS (한국 영화관입장권통합전산망) API 키
# 발급: https://www.kobis.or.kr → 마이페이지 → 오픈API → 키 발급/관리
KOBIS_API_KEY=your_kobis_api_key

# Railway 배포 시 추가: 프론트엔드 Vercel 도메인으로 변경
CORS_ORIGINS=https://your-app.vercel.app

# 레이트리밋을 방문자별로 걸기 위한 공유 비밀값 (Railway·Vercel 양쪽에 같은 값)
# 만들기: python -c "import secrets; print(secrets.token_urlsafe(32))"
# 있으면 Vercel을 거치지 않은 /api/chat 요청은 403. 없으면(로컬) 접속 주소로 센다. 이유는 rules/server.md "레이트 리미팅".
# PROXY_SECRET=

# 브리핑 승인 API·관리자 화면(/admin/briefings)의 토큰. 브리핑은 Postgres(DATABASE_URL)가 있을 때만 켜진다.
# compose는 DATABASE_URL을 자동으로 넣는다. 만들기: python -c "import secrets; print(secrets.token_urlsafe(24))"
# ADMIN_TOKEN=
# DATABASE_URL=postgresql://user:pass@host:5432/db
# 승인된 브리핑을 보낼 Discord 웹훅(채널 설정 → 연동 → 웹후크). 없으면 보내지 않고 기록만 한다.
# DISCORD_WEBHOOK_URL=
# 승인 요청·트리거 실패 알림용 웹훅(브리핑 채널과 따로 두면 좋다). 없으면 알리지 않는다.
# DISCORD_REVIEW_WEBHOOK_URL=
# 알림에 넣을 관리자 화면 주소
# ADMIN_URL=http://localhost:3000/admin/briefings
# BRIEFING_APPROVAL_TTL_HOURS=48

# 대화 체크포인트 DB (선택)
# 기본값은 vectorstore/checkpoints.sqlite. Railway는 /app/vectorstore가 이미 영구 볼륨이라
# 별도 설정 없이 재시작 후에도 대화가 보존된다.
# CHECKPOINT_DB_PATH=vectorstore/checkpoints.sqlite

# 로깅 (선택 — 미설정 시 아래 기본값)
LOG_LEVEL=INFO          # DEBUG/INFO/WARNING/ERROR
LOG_FORMAT=json         # json(프로덕션) / console(로컬 개발용 컬러 출력)
