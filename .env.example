OPENAI_API_KEY=your_openai_api_key
TAVILY_API_KEY=your_tavily_api_key
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key
LANGCHAIN_PROJECT=imdb-rag-chatbot

# KOBIS (한국 영화관입장권통합전산망) API 키
# 발급: https://www.kobis.or.kr → 마이페이지 → 오픈API → 키 발급/관리
KOBIS_API_KEY=your_kobis_api_key

# Railway 배포 시 추가: 프론트엔드 Vercel 도메인으로 변경
CORS_ORIGINS=https://your-app.vercel.app

# 레이트리밋을 방문자별로 걸기 위한 공유 비밀값 (Railway·Vercel 양쪽에 같은 값)
# 만들기: python -c "import secrets; print(secrets.token_urlsafe(32))"
# 없으면 Vercel이 넘기는 방문자 IP를 믿지 않는다. 자세한 이유는 rules/server.md "레이트 리미팅".
# PROXY_SECRET=

# 대화 체크포인트 DB (선택)
# 기본값은 vectorstore/checkpoints.sqlite. Railway는 /app/vectorstore가 이미 영구 볼륨이라
# 별도 설정 없이 재시작 후에도 대화가 보존된다.
# CHECKPOINT_DB_PATH=vectorstore/checkpoints.sqlite

# 로깅 (선택 — 미설정 시 아래 기본값)
LOG_LEVEL=INFO          # DEBUG/INFO/WARNING/ERROR
LOG_FORMAT=json         # json(프로덕션) / console(로컬 개발용 컬러 출력)
