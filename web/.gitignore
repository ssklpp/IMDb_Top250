# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# 템플릿은 추적한다. README가 이 파일을 가리키는데 예전엔 이 규칙에 걸려 저장소에 없었다(B-014).
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
